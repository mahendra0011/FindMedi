{
  "settings": {
    "index": {
      "number_of_shards": 3,
      "number_of_replicas": 1
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "eventId": { "type": "keyword" },
      "eventType": { "type": "keyword" },
      "aggregateId": { "type": "keyword" },
      "aggregateType": { "type": "keyword" },
      "vertical": { "type": "keyword" },
      "status": { "type": "keyword" },
      "timestamp": { "type": "date" },
      "ipAddress": { "type": "ip" },
      "clientUserAgent": { "type": "keyword" },
      "actorId": { "type": "keyword" },
      "actorRole": { "type": "keyword" },
      "metadata": {
        "type": "object",
        "dynamic": "strict",
        "properties": {
          "durationMs": { "type": "long" },
          "resultCount": { "type": "integer" },
          "httpStatus": { "type": "integer" },
          "source": { "type": "keyword" },
          "reason": { "type": "keyword" }
        }
      }
    }
  }
}
