  "findings": {
    "sharp_resize_is_hotspot": "Large image (3000x2000) resize averages 103ms — the #1 CPU bottleneck in the image pipeline. The avatar pipeline (validate+resize+encode) averages 21ms for medium images.",
    "pdfkit_linear_scaling": "PDF generation scales roughly linearly with item count: 5 items = 9.7ms, 100 items = 83.7ms. The drawTable and heightOfString calls dominate.",
    "csv_toCSV_faster_than_json2csv": "Hand-rolled toCSV (4.25ms for 1k rows) outperforms json2csv (6.68ms for 1k rows) — the custom function avoids json2csv's object mapping overhead.",
    "exceljs_parse_dominates_import": "ExcelJS xlsx parsing is the slowest path: 5k rows = 207ms. This is the strongest candidate for Rust migration.",
    "magic_byte_validation_trivial": "Magic-byte validation is sub-microsecond (~1.7M ops/sec). Not worth migrating to Rust — keep as-is.",
    "heap_pressure": "PDF generation and ExcelJS parsing both show significant heap growth (5-36 MB delta) due to buffer accumulation and object creation."
  }
}
