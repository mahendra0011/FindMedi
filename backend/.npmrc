# Lockfile authoring parity — ye file LOCKFILE ke saath chalti hai.
#
# Dev machine ke global ~/.npmrc me `legacy-peer-deps=true` set hai, aur
# lockfile usi mode me author hua hai. Is flag se host, CI aur Docker teeno
# ek jaisa install karenge (strict peer validation alag tree bana sakta hai).
legacy-peer-deps=true
