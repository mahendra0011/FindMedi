# Optional backend-only example.
# MERGED MODE (default): MindSupport runs inside the main FindMedi server
# (backend/src/index.js) under /api/mindsupport/* using the main MONGO_URI.
# Only MIND_MONGODB_URI is honoured as an override; the vars below apply to
# legacy standalone mode (`npm run dev:mind`, port 8089) only.

PORT=5001
CLIENT_ORIGIN=http://localhost:8080
MONGODB_URI=mongodb://127.0.0.1:27017/mindsupport
MONGODB_DATABASE=mindsupport
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MindSupport Admin
GOOGLE_MEET_DEFAULT_LINK=
YOUTUBE_API_KEY=

# Brevo (Sendinblue) API key for transactional emails (OTP, welcome, etc.)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=mindsupport@example.com
BREVO_SENDER_NAME=MindSupport

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# JWT Access & Refresh tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

