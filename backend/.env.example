# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Redis (optional — only needed for multi-instance Socket.IO / shared rate limiting)
# Leave unset for local dev: the server then uses Socket.IO's in-memory adapter
# and in-memory rate limiting, which is fine for a single dev server.
# REDIS_URL=redis://localhost:6379

# MongoDB Atlas - REPLACE WITH YOUR ACTUAL CONNECTION STRING
# Get this from MongoDB Atlas -> Clusters -> Connect -> Driver
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.avvnhcg.mongodb.net/findmedi?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Admin seeding credentials (used when running seed:admin script only)
ADMIN_EMAIL=admin@findmedi.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Admin User

# Cloudinary (for file uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Brevo Email API Configuration (for OTP, notifications, reports)
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email_here

# Google OAuth 2.0 (for "Continue with Google" login)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Use "Web application" type, add http://localhost:5173 to Authorized JavaScript origins
# and http://localhost:5173 to Authorized redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Drive API (for secure personal file storage)
# Uses the same OAuth 2.0 Client ID as above, but requires the client secret
# and a backend redirect URI registered in the Google Cloud Console.
# Add the redirect URI (e.g. http://localhost:5001/api/drive/callback) to
# Authorized redirect URIs in the Google Cloud Console.
# Enable the Google Drive API in the Google Cloud Console.
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5001/api/drive/callback

# ─── INSTANT DISPATCH (File 06 §8 — wave engine radii, env-tunable) ──────────
# Comma-separated km tiers tried in order until a provider accepts.
INSTANT_RIDE_RADII=3,6,10
INSTANT_LAWYER_RADII=5,10,20
INSTANT_ASSISTANT_RADII=2,5,10
INSTANT_DOCTOR_RADII=10,25,50
# Seconds each wave waits for accept-votes before escalating radius.
INSTANT_WAVE_WINDOW_SECONDS=15
# Legacy sequential ride dispatch tiers (rideService fallback path).
# RIDE_STANDARD_RADIUS_STEPS=5,10,20,40
# RIDE_EMERGENCY_RADIUS_STEPS=15,30,50

# ─── H3 GEOSPATIAL CACHE (File 02 — Redis fast-path, Mongo stays truth) ─────
H3_MAX_RING_K=8
H3_MIN_CANDIDATES=6
# HEX_RECONCILE_INTERVAL_MS=300000

# ─── SOS EMERGENCY DISPATCH ──────────────────────────────────────────────────
# SOS_AMBULANCE_RADII=5,10,15
# SOS_VEHICLE_RADII=5,10,15
# SOS_WINDOW_SECONDS=30
# SOS_LOCATION_MAX_AGE_SECONDS=120
# SOS_MAX_CANDIDATES_PER_WAVE=30

# ─── EVENT BACKBONE (Specs 10/11 — Kafka + outbox; dev-safe when unset) ──────
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_CLIENT_ID=findmedi-core-api
# SCHEMA_REGISTRY_URL=http://localhost:8081
# OUTBOX_BATCH_SIZE=50
# OUTBOX_POLL_INTERVAL_MS=2000

# ─── ROUTING + SEARCH + SURGE (Specs 02/14/15) ───────────────────────────────
# VALHALLA_API_URL=http://localhost:8002
# VALHALLA_TIMEOUT_MS=2500
# OPENSEARCH_NODE=http://localhost:9200
# SURGE_CALC_INTERVAL_MS=60000

# ─── VIDEO MEDIA (LiveKit self-hosted; unset = audio/call fallback) ─────────
# LIVEKIT_URL=http://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=change-me-in-production

# ─── SEED COMMANDS ───────────────────────────────────────────────────────────
# 1. Seed only admin (uses ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_NAME from .env)
#    Command: npm run seed:admin --prefix backend
#    This creates just the admin user without any demo data.
#
# 2. Seed full demo data (admin + doctors + patients + appointments + etc.)
#    Command: npm run seed --prefix backend
#    This deletes all existing data and creates fresh demo records.
#
# 3. Seed without deleting existing data (safe for production clusters)
#    Command: npm run seed:cluster --prefix backend
#    This upserts data, preserving existing records.

# ─── MINDSUPPORT MERGE (Phase 2) ─────────────────────────────────────────────
# MindSupport counselling platform now runs INSIDE this server under
# /api/mindsupport/* (single port 5001, single MongoDB). Standalone :8089 is
# legacy fallback only.
# Optional: point MindSupport at a different MongoDB (e.g. during migration).
# When unset, MindSupport reuses MONGO_URI above (single DB `findmedi`).
# MIND_MONGODB_URI=mongodb://127.0.0.1:27017/findmedi
# Legacy standalone port (only used by `npm run dev:mind` / `start:mind`).
# MIND_PORT=8089
# Set to 0 to keep main server DNS config when MindSupport is mounted in-process.
# MIND_DNS_OVERRIDE=0