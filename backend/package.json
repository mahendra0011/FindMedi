{
  "name": "findmedi-server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch-path=./.env --watch-path=./src src/index.js",
    "start": "node src/index.js",
    "dev:mind": "node --watch-path=./mindsupport/src mindsupport/server.js",
    "start:mind": "node mindsupport/server.js",
    "seed": "node seed-demo.mjs",
    "seed:all": "node seed-demo.mjs",
    "seed:psychiatrists": "node seed-psychiatrists.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:pharmacy:replica": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --runInBand test/integration/pharmacyDispenseReplicaSet.spec.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --coverage",
    "lint": "eslint .",
    "authz:triage": "node scripts/triage-authz-gaps.mjs",
    "authz:coverage": "node scripts/check-authz-coverage.mjs",
    "authz:tenant-guard": "node scripts/check-tenant-guard-regression.mjs",
    "missing:inventory": "node scripts/missing-feature-inventory.mjs",
    "docs:dictionary": "node scripts/gen-data-dictionary.mjs",
    "docs:dictionary:check": "node scripts/gen-data-dictionary.mjs --check",
    "retention:gaps": "node scripts/check-retention-gaps.mjs",
    "migrate:category-taxonomy": "node scripts/migrate-category-taxonomy.mjs"
  },
  "dependencies": {
    "@bull-board/api": "^6.11.0",
    "@bull-board/express": "^6.11.0",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@json2csv/plainjs": "^7.0.8",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.4.0",
    "bwip-js": "^4.11.4",
    "clamav.js": "^0.12.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "file-type": "^22.1.1",
    "google-auth-library": "^10.9.0",
    "h3-js": "^4.5.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.0",
    "json-logic-js": "^2.0.5",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "livekit-server-sdk": "^2.19.1",
    "mongoose": "^9.10.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.54.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "sanitize-html": "^2.12.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.spec.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/helpers/",
      "\\.test\\.js$"
    ],
    "testTimeout": 20000,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/"
    ],
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/utils/**/*.js",
      "src/middleware/**/*.js",
      "src/models/**/*.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 5,
        "functions": 5,
        "lines": 15,
        "statements": 14
      }
    }
  },
  "overrides": {
    "uuid": "11.1.1",
    "braces": "3.0.3"
  }
}
