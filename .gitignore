node_modules/
dist/
.env
*.local
.DS_Store
*.out
*.log
server.err
response.txt


# Local dev overrides
.env.local
logs/
.zcode/

# Stray test / verification logs — never commit these.
test-out.txt
test-err.txt
*-out.txt
*-err.txt
navtest.txt

# Generated by `npm run analyze` (frontend) — reproducible, never commit.
bundle-analysis.html

# INF-B-01: TLS private keys and ACME state must never be committed.
infra/nginx/certs/*
!infra/nginx/certs/.gitkeep
infra/nginx/certbot/*
!infra/nginx/certbot/.gitkeep
*.pem
*.key
infra/backup/secrets/*
!infra/backup/secrets/.gitkeep
# DP-B-02: Kafka keystores/creds + JAAS are machine-local (generated by
# `npm run infra:up`) — never commit secrets.
infra/kafka/secrets/*

# RUST-B-03: ad-hoc test output captures. These are scratch files from
# debugging runs, not fixtures - committing them leaks environment detail and
# adds noise to every diff.
jest-*.txt
*.out
*.tmp
