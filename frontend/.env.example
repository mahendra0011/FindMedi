# Backend API URL (must include /api at the end)
# Local development:
VITE_API_URL=http://localhost:5001/api

# Map detail pages
# Routing needs no key — it goes through this app's own backend
# (POST /api/routing/navigation → self-hosted Valhalla). Previously this used
# OpenRouteService via VITE_OPENROUTESERVICE_API_KEY; that was removed because
# it was rate-capped and the key shipped in the public JS bundle.
# VITE_MAPTILER_API_KEY=your_maptiler_key
# VITE_USE_MAPTILER_TILES=true
# VITE_USE_MAPTILER_GEOCODING=true

# Render deployment:
# VITE_API_URL=https://findmedi-main.onrender.com/api

# Feature Flags (Unleash)
# VITE_UNLEASH_URL=http://localhost:4242/api/
# VITE_UNLEASH_CLIENT_KEY=your_unleash_client_key

# PostHog Analytics
# VITE_POSTHOG_API_KEY=phc_your_api_key
# VITE_POSTHOG_HOST=https://app.posthog.com
