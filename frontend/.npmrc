# Lockfile authoring parity — ye file LOCKFILE ke saath chalti hai.
#
# Duniya bhar me `legacy-peer-deps=true` (npm 6 jaisa peer handling) use hua
# hai jab ye lockfile banaya/badala gaya tha (dev machine ka global ~/.npmrc).
# Bina iske `npm ci` (containers, CI) required peers jaise
# `@types/dom-mediacapture-record` (livekit-client) ko lockfile me MANGTA hai
# aur EUSAGE "out of sync" error ke saath fail hota hai.
#
# Isliye: project ke andar ye flag RAKHO — host, CI aur Docker teeno ek jaisa
# install karenge. Delete mat karo, warna `npm ci` dobara toot jayega.
legacy-peer-deps=true
